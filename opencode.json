{
  "$schema": "https://opencode.ai/config.json",
  "lsp": {
    "autohotkey": {
      "command": [
        "node",
        "C:\\Users\\chunk\\vscode-autohotkey2-lsp\\server\\dist\\server.js",
        "--stdio"
      ],
      "extensions": [".ahk", ".ah2", ".ahk1", ".ahk2"],
      "initialization": {
        "locale": "en-us",
        "InterpreterPath": "C:\\Program Files\\AutoHotkey\\v2\\AutoHotkey.exe",
        "AutoLibInclude": "Disabled",
        "ActionWhenV1IsDetected": "Continue",
        "Diagnostics": {
          "ClassStaticMemberCheck": true,
          "ParamsCheck": true
        },
        "FormatOptions": {
          "indent_string": "\t"
        }
      }
    }
  }
}